  <ConfigurationA>
    <AliasDbA>@DB_Source</AliasDbA>
    <QueryA>SELECT 
    c.TABLE_NAME,
    c.COLUMN_NAME,
    c.DATA_TYPE,
    c.DATA_LENGTH,
    c.NULLABLE
FROM 
    ALL_TABLES t
JOIN 
    ALL_TAB_COLUMNS c
    ON t.OWNER = c.OWNER AND t.TABLE_NAME = c.TABLE_NAME
WHERE 
    t.OWNER = UPPER('@param1')   -- Replace with your schema
    AND t.TEMPORARY = 'N'           -- exclude temporary tables
    AND t.NESTED = 'NO'             -- exclude nested tables
    AND t.IOT_TYPE IS NULL          -- keine Index-Organized Tables
    AND c.TABLE_NAME != 'EBROPERATIONALTIMESPECPROP'
ORDER BY 
    c.TABLE_NAME,
    c.COLUMN_ID</QueryA>
    <Active>true</Active>
  </ConfigurationA>
  <ConfigurationB>
    <AliasDbB>@DB_Target</AliasDbB>
    <QueryB>SELECT 
    UPPER(c.table_name) as table_name,
    UPPER(c.column_name) as column_name,
    UPPER(c.data_type) as data_type ,
    c.character_maximum_length as data_length,
    LEFT(UPPER(c.is_nullable),1) as nullable
FROM 
    information_schema.columns c
JOIN
    pg_tables t
    ON c.table_schema = t.schemaname
    AND c.table_name = t.tablename
WHERE 
    c.table_schema = '@param2'  -- replace with your schema
ORDER BY 
    c.table_name,
    c.ordinal_position</QueryB>
    <Active>true</Active>
  </ConfigurationB>
  <Join>
    <JoinType>0</JoinType>
    <Unique>true</Unique>
    <Sorted>true</Sorted>
  </Join>
