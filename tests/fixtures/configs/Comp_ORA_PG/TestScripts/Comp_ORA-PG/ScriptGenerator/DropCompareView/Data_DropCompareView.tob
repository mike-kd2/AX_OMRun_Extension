  <ConfigurationA>
    <AliasDbA>@DB_Source</AliasDbA>
    <QueryA>/* Original Oracle script for OMrun */
SELECT DISTINCT 
    '@DB_Source_Name' AS view_catalog,
    '@SCHEMA_Source' AS view_schema,
    'v_CreateCompareView' AS ora_view_name
FROM dual

/*BODY*/
DECLARE
    v_count INTEGER;
    v_view_name VARCHAR2(30) := UPPER('@param1'); -- Replace with your view name
BEGIN
    -- Check if the view exists
    SELECT COUNT(*)
    INTO v_count
    FROM user_views
    WHERE view_name = v_view_name;

    -- If the view exists, drop it
    IF v_count &gt; 0 THEN
        EXECUTE IMMEDIATE 'DROP VIEW ' || UPPER ('@SCHEMA_Source') || '.' || v_view_name;
    END IF;
END;
</QueryA>
    <Active>true</Active>
  </ConfigurationA>
  <ConfigurationB>
    <AliasDbB>@DB_Target_Admin</AliasDbB>
    <QueryB>/* Original PostgreSQL script for OMrun */
SELECT 
    current_database() AS view_catalog,
       '@SCHEMA_Target' AS view_schema, 
       'v_CreateCompareView' AS ora_view_name
FROM information_schema.Tables
limit 1

/*BODY*/
DROP VIEW IF EXISTS @SCHEMA_Target.@param2</QueryB>
    <Active>true</Active>
  </ConfigurationB>
