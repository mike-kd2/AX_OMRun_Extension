    <_x0040_key1>D:\omrun_templates\Comparison\TestScripts;Comparison_ORA_PG;DataCompare;demo_source.categories;demo_target.categories</_x0040_key1>
    <_x0040_key2>SELECT 
   category_id AS category_id,
   category_name AS category_name,
   description AS description,
   CASE WHEN picture IS NOT NULL 
						 THEN LOWER(RAWTOHEX(DBMS_CRYPTO.HASH(PICTURE, 4))) 
						 ELSE NULL 
					END AS picture_blob_hash
FROM demo_source.categories</_x0040_key2>
    <_x0040_key3>SELECT 
   case when picture is not null then LOWER(encode(digest(picture, 'sha256'), 'hex')) else null end AS picture_blob_hash,
   category_id AS category_id,
   category_name AS category_name,
   description AS description
FROM demo_target.categories</_x0040_key3>
