  <ConfigurationA>
    <AliasDbA>@DB_Source</AliasDbA>
    <QueryA>/* Original Oracle script for OMrun */
SELECT
x.table_name AS table_name
,x.pk_attribute AS pk_attribute
,x.table_catalog AS table_catalog
,x.infrastructur_info AS infrastructur_info
,x.select_statement AS select_statement
FROM @SCHEMA_Source.@param1 x
WHERE 
    x.table_name NOT IN ('enumset','pls_unittag') -- excluding materialized views
    AND x.table_name NOT IN ('wei_erpinboundmessage','wei_erpoutboundmessage','ebroperationaltimespecprop') -- temporary excluding, under investigation
ORDER BY x.table_name</QueryA>
    <Active>true</Active>
  </ConfigurationA>
  <ConfigurationB>
    <AliasDbB>@DB_Target</AliasDbB>
    <QueryB>/* Original PostgreSQL script for OMrun */
SELECT
x.table_name AS table_name
,x.pk_attribute AS pk_attribute
,x.table_catalog AS table_catalog
,x.infrastructur_info AS infrastructur_info
,x.select_statement AS select_statement
FROM @SCHEMA_Target.@param2 x
WHERE 
    x.table_name NOT IN ('wei_erpinboundmessage','wei_erpoutboundmessage','ebroperationaltimespecprop') -- temporary excluding, under investigation
ORDER BY x.table_name

</QueryB>
    <Active>true</Active>
  </ConfigurationB>
  <Join>
