  <ConfigurationA>
    <AliasDbA>@DB_Source_Admin</AliasDbA>
    <QueryA>SELECT
    'Set crypto settings to database' AS Cripto_Settings
FROM dual

/*BODY*/
-- Get hash code on blobs HASH_SH256 */
-- Admin user only is aloued to grant execution rights

/* Attention!!! This command needs manuel execution ones on sys User with SYSDBA rigthts */
/* Hashing von BLOBS wird so ermöglicht                                                                                   */
--GRANT EXECUTE ON sys.dbms_crypto TO @SCHEMA_Source;</QueryA>
    <Active>true</Active>
  </ConfigurationA>
  <ConfigurationB>
    <AliasDbB>@DB_Target_Admin</AliasDbB>
    <QueryB>SELECT 
    t.Cripto_Settings AS Cripto_Settings
FROM 
(
    select 'Set crypto settings to database' AS Cripto_Settings
) as t

/*BODY*/
-- If not installed, install pgcrypto extension (requires superuser privileges)
CREATE EXTENSION IF NOT EXISTS pgcrypto;

GRANT USAGE ON SCHEMA public TO @USER_Target;
GRANT USAGE ON SCHEMA @SCHEMA_Target TO @USER_Target;

GRANT EXECUTE ON FUNCTION digest(text, text) TO @USER_Target;
GRANT EXECUTE ON FUNCTION digest(bytea, text) TO @USER_Target;
GRANT EXECUTE ON FUNCTION encode(bytea, text) TO @USER_Target;</QueryB>
    <Active>true</Active>
  </ConfigurationB>
  <Join>
    <JoinType>0</JoinType>
    <Unique>true</Unique>
    <Sorted>true</Sorted>
  </Join>
