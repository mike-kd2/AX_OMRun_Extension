  </TabAliasB>
  <ConfigurationA>
    <AliasDbA>@DB_Source</AliasDbA>
    <QueryA>SELECT 
    '@SCHEMA_Source' AS schema,
    t.TABLE_NAME AS table_name,
    t.NUM_ROWS AS row_count,
    'Split@param1' AS scenario_parameter_list,
    (SELECT CONCAT(CONCAT(atc.column_name, ' - '), atc.data_type)
     FROM all_constraints c
     JOIN all_cons_columns cc ON c.constraint_name = cc.constraint_name AND c.owner = cc.owner
     JOIN all_tab_columns atc ON atc.table_name = cc.table_name AND atc.column_name = cc.column_name AND atc.owner = cc.owner
     WHERE c.constraint_type = 'P' 
       AND c.owner = UPPER('@SCHEMA_Source')
       AND c.table_name = t.TABLE_NAME
       AND cc.position = 1
     FETCH FIRST 1 ROWS ONLY) AS first_key_data_type
FROM 
    all_tables t
WHERE 
    t.TABLESPACE_NAME =  '@param4' -- normaly users 'USERS' 
    AND t.OWNER = UPPER('@SCHEMA_Source') 
    AND CAST(t.NUM_ROWS AS INT) &gt;= @param2 -- untere Row-Grenze
    AND CAST(t.NUM_ROWS AS INT) &lt; @param3 -- obere Row-Grenze
ORDER BY first_key_data_type</QueryA>
    <Active>true</Active>
  </ConfigurationA>
  <ConfigurationB>
    <AliasDbB>@DB_Target</AliasDbB>
    <QueryB>select
	'@SCHEMA_Target' as schema
	,'@param1' as table_name
	,COUNT(*) as row_count
from @SCHEMA_Target.@param1</QueryB>
    <Active>false</Active>
  </ConfigurationB>
  <Join>
    <JoinType>0</JoinType>
    <Unique>true</Unique>
    <Sorted>true</Sorted>
  </Join>
</DataSetTestObject>