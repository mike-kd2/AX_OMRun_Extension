                <xs:element name="ThrustedUser" type="xs:boolean" default="true" minOccurs="0" />
                <xs:element name="Environment_Id" msdata:AutoIncrement="true" type="xs:int" minOccurs="0" />
                <xs:element name="PasswordHidden" msdata:Caption="Password" type="xs:string" default="" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
      <xs:unique name="Constraint1">
        <xs:selector xpath=".//mstns:Environment" />
        <xs:field xpath="mstns:DbAlias" />
      </xs:unique>
      <xs:unique name="Constraint2">
        <xs:selector xpath=".//mstns:Environment" />
        <xs:field xpath="mstns:Number" />
      </xs:unique>
      <xs:unique name="EnvironmentGlobal_Constraint1" msdata:ConstraintName="Constraint1">
        <xs:selector xpath=".//mstns:EnvironmentGlobal" />
        <xs:field xpath="mstns:Environment_Id" />
      </xs:unique>
    </xs:element>
  </xs:schema>
