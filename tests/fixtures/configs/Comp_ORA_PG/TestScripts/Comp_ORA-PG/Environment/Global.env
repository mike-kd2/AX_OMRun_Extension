<?xml version="1.0" standalone="yes"?>
<DataSetEnvironment xmlns="http://tempuri.org/DataSetEnvironment.xsd">
  <xs:schema id="DataSetEnvironment" targetNamespace="http://tempuri.org/DataSetEnvironment.xsd" xmlns:mstns="http://tempuri.org/DataSetEnvironment.xsd" xmlns="http://tempuri.org/DataSetEnvironment.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:msprop="urn:schemas-microsoft-com:xml-msprop" attributeFormDefault="qualified" elementFormDefault="qualified">
    <xs:element name="DataSetEnvironment" msdata:IsDataSet="true" msdata:Locale="en-US" msprop:OMrunVersion="5.5.0.10" msprop:Activated="True">
      <xs:complexType>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Environment">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="Server" type="xs:string" minOccurs="0" />
                <xs:element name="Db" type="xs:string" minOccurs="0" />
                <xs:element name="DbType" type="xs:string" minOccurs="0" />
                <xs:element name="DbAlias" type="xs:string" default="@" minOccurs="0" />
                <xs:element name="UserName" type="xs:string" minOccurs="0" />
                <xs:element name="Password" type="xs:string" minOccurs="0" />
                <xs:element name="TrustedUser" type="xs:boolean" default="true" minOccurs="0" />
                <xs:element name="Number" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="10" msdata:AutoIncrementStep="10" type="xs:int" minOccurs="0" />
                <xs:element name="PasswordHidden" msdata:Caption="Password" type="xs:string" default="" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
      <xs:unique name="Constraint1">
        <xs:selector xpath=".//mstns:Environment" />
        <xs:field xpath="mstns:DbAlias" />
      </xs:unique>
      <xs:unique name="Constraint2">
        <xs:selector xpath=".//mstns:Environment" />
        <xs:field xpath="mstns:Number" />
      </xs:unique>
    </xs:element>
  </xs:schema>
