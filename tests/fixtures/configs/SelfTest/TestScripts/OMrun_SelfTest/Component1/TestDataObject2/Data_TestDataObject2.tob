  <BusinessMapping>
    <BusinessRule_Id>0</BusinessRule_Id>
    <BusNameA>SourceA.Id</BusNameA>
    <BusAliasA>A_Id</BusAliasA>
    <BusNameB>SourceB.Id</BusNameB>
    <BusAliasB>B_Id</BusAliasB>
    <Function>=</Function>
    <Low />
    <High />
    <Rule>@A_Id</Rule>
    <Rounding />
    <Key>true</Key>
    <Active>true</Active>
    <Description>Generated</Description>
    <Info>false</Info>
