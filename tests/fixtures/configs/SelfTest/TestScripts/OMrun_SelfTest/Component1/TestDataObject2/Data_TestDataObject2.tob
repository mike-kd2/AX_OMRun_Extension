  <ConfigurationA>
    <AliasDbA>@DB_Quote</AliasDbA>
    <QueryA>SELECT
   T.OMrun_Variable
   ,T.Content
FROM
(
SELECT TOP 1
   '#OMrunVersion#' AS Content
  ,'#'+'OMrunVersion'+'#' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '@ENV' AS Content
   ,'#'+'OMrunEnvironment'+'#' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '@BSS' AS Content
   ,'#'+'OMrunBusinessSystem'+'#' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '#OMrunProjectPath#' AS Content
   ,'#'+'OMrunProjectPath'+'#' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '#OMrunUserDataPath#' AS Content
   ,'#'+'OMrunUserDataPath'+'#' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '#OMrunBuiltInTest#' AS Content
   ,'#'+'OMrunBuiltInTest'+'#' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '#OMrunMigration#' AS Content
   ,'#'+'OMrunMigration'+'#' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '#OMrunTestDB#' AS Content
   ,'#'+'OMrunTestDB'+'#' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '@SCRIPT' AS Content
   ,'@'+'SCRIPT = '+'#'+'OMrunProjectPath#\TestScripts' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '@DATA' AS Content
   ,'@'+'DATA = ' +'#'+'OMrunProjectPath#\TestData' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '@BATCH' AS Content
   ,'@'+'BATCH = ' +'#'+'OMrunProjectPath#\BatchJobs' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '@REPORT' AS Content
  ,'@'+'REPORT = ' +'#'+'OMrunProjectPath#\Reports' AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '@QUERY' AS Content
   ,'@'+'QUERY = ' +'#'+'OMrunProjectPath#\Queries'  AS OMrun_Variable
FROM [T_Quote$]  Q
UNION
SELECT TOP 1
   '@ARCHIVE' AS Content
   ,'@'+'ARCHIVE= ' +'#'+'OMrunProjectPath#\Archive'  AS OMrun_Variable
FROM [T_Quote$]  Q
) T
ORDER BY T.OMrun_Variable ASC	</QueryA>
  </ConfigurationA>
  <ConfigurationB>
    <AliasDbB>@</AliasDbB>
    <QueryB />
    <Active>false</Active>
  </ConfigurationB>
